<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Список статей</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>Список статей (EJS)</h1>
    <ul>
      <% articles.forEach(article => { %>
        <li>
          <span><%= article.title %></span>
          <a href="/articles/<%= article.id %>">Читати далі</a>
        </li>
      <% }) %>
    </ul>
    <div class="nav">
      <a href="/users">Перейти до користувачів (PUG)</a>
    </div>
  </div>
</body>
</html>
