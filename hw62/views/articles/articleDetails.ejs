<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Деталі статті</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1><%= article.title %> (EJS)</h1>
    <div class="card">
      <p><strong>ID:</strong> <%= article.id %></p>
      <p><strong>Автор:</strong> <%= article.author %></p>
      <p><strong>Зміст:</strong> <%= article.content %></p>
    </div>
    <div class="nav">
      <a href="/articles">Назад до списку статей</a>
    </div>
  </div>
</body>
</html>
