doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Список користувачів
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      h1 Список користувачів (PUG)
      ul
        each user in users
          li
            span #{user.name} (#{user.role})
            a(href=`/users/${user.id}`) Детальніше
      .nav
        a(href="/articles") Перейти до статей (EJS)
