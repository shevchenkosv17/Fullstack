doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Деталі користувача
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      h1 Інформація про користувача (PUG)
      .card
        p
          strong ID: 
          | #{user.id}
        p
          strong Ім'я: 
          | #{user.name}
        p
          strong Email: 
          | #{user.email}
        p
          strong Роль: 
          | #{user.role}
      .nav
        a(href="/users") Назад до списку користувачів
